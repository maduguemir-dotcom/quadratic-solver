import unittest
from solver import solve_quadratic

class TestQuadraticSolver(unittest.TestCase):

    def test_two_real_roots(self):
        # x^2 - 5x + 6 = 0 -> roots 3.0, 2.0
        r1, r2 = solve_quadratic(1, -5, 6)
        self.assertEqual((r1, r2), (3.0, 2.0))

    def test_one_real_root(self):
        # x^2 - 4x + 4 = 0 -> root 2.0
        r1, r2 = solve_quadratic(1, -4, 4)
        self.assertEqual((r1, r2), (2.0, 2.0))

    def test_complex_roots(self):
        # x^2 + 1 = 0 -> roots +1j, -1j
        r1, r2 = solve_quadratic(1, 0, 1)
        self.assertEqual(r1, 1j)
        self.assertEqual(r2, -1j)

    def test_zero_a_coefficient(self):
        # Should raise ValueError when a = 0
        with self.assertRaises(ValueError):
            solve_quadratic(0, 2, 3)

if __name__ == "__main__":
    unittest.main()
